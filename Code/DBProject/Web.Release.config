<?xml version="1.0" encoding="utf-8"?>

<!--
  cr-dotnet-0010: Web.config Transformations — MIGRATED to environment-based configuration.

  Build-time Web.config XDT transformations have been replaced with ASP.NET Core's
  environment-based configuration system following 12-factor app principles.

  MIGRATION SUMMARY
  =================
  Previously this file used XDT (XML Document Transform) directives such as
  xdt:Transform="SetAttributes", xdt:Transform="RemoveAttributes(debug)", and
  xdt:Transform="Replace" to modify Web.config values at build time for the
  Release / Production environment.

  These build-time transformations do NOT work effectively in cloud deployment
  pipelines (Azure DevOps, GitHub Actions, Azure Container Apps) where the
  application image is built once and promoted across environments.

  REPLACEMENT APPROACH
  ====================
  Environment-specific configuration is now handled at RUNTIME via:

  1. appsettings.json            — base configuration (committed to source control)
  2. appsettings.Production.json — Production overrides (committed, no secrets)
  3. Environment variables       — sensitive values and environment-specific overrides
                                    set in Azure App Service "Application Settings" or
                                    Azure Container Apps "Environment Variables"

  KEY MAPPINGS (Release / Production environment)
  ================================================
  The following values that were previously transformed by this file are now
  configured via environment variables or appsettings.Production.json:

  | Old Web.config key                       | New mechanism                              |
  |-------------------------------------------|--------------------------------------------|
  | connectionStrings/sqlCon1                 | Env var: SQLCON1_CONNECTION_STRING         |
  | system.web/compilation[@debug] (removed)  | ASPNETCORE_ENVIRONMENT=Production          |
  | system.web/customErrors[@mode=RemoteOnly] | appsettings.Production.json                |

  AZURE APP SERVICE CONFIGURATION
  ================================
  Set the following Application Settings in the Azure portal (or via Azure CLI):
    az webapp config appsettings set \
      --name <app-name> \
      --resource-group <rg> \
      --settings \
        ASPNETCORE_ENVIRONMENT=Production \
        SQLCON1_CONNECTION_STRING="<your-production-connection-string>"

  For production connection strings, use Azure Key Vault references:
    SQLCON1_CONNECTION_STRING=@Microsoft.KeyVault(SecretUri=https://<vault>.vault.azure.net/secrets/sqlcon1-connection-string/)

  AZURE CONTAINER APPS CONFIGURATION
  ====================================
  Set environment variables in the Container App:
    az containerapp update \
      --name <app-name> \
      --resource-group <rg> \
      --set-env-vars \
        ASPNETCORE_ENVIRONMENT=Production \
        SQLCON1_CONNECTION_STRING=secretref:sqlcon1-connection-string

  AZURE KEY VAULT INTEGRATION
  ============================
  For production secrets, store the connection string in Azure Key Vault and
  reference it via Managed Identity:
    - Secret name: sqlcon1-connection-string
    - Access policy: App Service / Container App Managed Identity with Get permission
    - Reference in App Settings: @Microsoft.KeyVault(SecretUri=...)

  This file is retained for reference only and is no longer processed by MSBuild.
-->

<configuration>
  <!--
    This transformation file is intentionally left without active XDT directives.
    All environment-specific configuration is managed via environment variables
    and appsettings.{Environment}.json files as described above.

    Production debug compilation is disabled by setting ASPNETCORE_ENVIRONMENT=Production,
    which automatically applies the Production configuration profile.
  -->
</configuration>
