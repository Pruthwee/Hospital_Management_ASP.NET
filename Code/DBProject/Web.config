<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud-Ready Configuration for Azure Deployment
  Connection strings and sensitive settings should be configured via environment variables
  For local development, use Web.config values as fallback
-->
<configuration>

    <connectionStrings>
      <!-- 
        Cloud-Ready Connection String Configuration
        In production, set SQL_CONNECTION_STRING environment variable
        Format: Data Source=<server>.database.windows.net;Initial Catalog=<database>;User ID=<username>;Password=<password>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
      -->
      <add name="sqlCon1" 
           connectionString="Data Source=.\SQLEXPRESS; Initial Catalog=DBProject; Integrated Security=True" 
           providerName="System.Data.SqlClient" />
    </connectionStrings>

    <appSettings>
      <!-- 
        Cloud Configuration Settings
        These should be overridden by environment variables in production:
        - REDIS_CONNECTION_STRING: Azure Cache for Redis connection string
        - SQL_CONNECTION_STRING: Azure SQL Database connection string
        - ASPNETCORE_ENVIRONMENT: Development, Staging, Production
      -->
      <add key="Environment" value="Development" />
      <add key="EnableDistributedSession" value="true" />
      <add key="EnableConnectionPooling" value="true" />
    </appSettings>
  
     
  <system.web>
    <compilation debug="true" targetFramework="4.6.1"/>
    <httpRuntime targetFramework="4.6.1"/>
    
    <!-- 
      Session State Configuration for Cloud Deployment
      For distributed session with Azure Cache for Redis, configure:
      - Mode="Custom" with Redis session state provider
      - Or use DistributedSessionManager class for programmatic control
    -->
    <sessionState mode="InProc" 
                  timeout="20" 
                  cookieless="false" 
                  regenerateExpiredSessionId="true" />
    
    <httpModules>
      <add name="ApplicationInsightsWebTracking" type="Microsoft.ApplicationInsights.Web.ApplicationInsightsHttpModule, Microsoft.AI.Web"/>
    </httpModules>
    
    <!-- Enable custom errors for production -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx">
      <error statusCode="404" redirect="~/NotFound.aspx" />
      <error statusCode="500" redirect="~/Error.aspx" />
    </customErrors>
    
    <!-- Security hardening for cloud deployment -->
    <httpCookies httpOnlyCookies="true" requireSSL="false" />
    <pages enableViewStateMac="true" validateRequest="true" />
  </system.web>
  
  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs"
        type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=1.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"
        warningLevel="4" compilerOptions="/langversion:6 /nowarn:1659;1699;1701"/>
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb"
        type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=1.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"
        warningLevel="4" compilerOptions="/langversion:14 /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+"/>
    </compilers>
  </system.codedom>
  
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false"/>
    <modules>
      <remove name="ApplicationInsightsWebTracking"/>
      <add name="ApplicationInsightsWebTracking" type="Microsoft.ApplicationInsights.Web.ApplicationInsightsHttpModule, Microsoft.AI.Web"
        preCondition="managedHandler"/>
    </modules>
    
    <!-- Security headers for cloud deployment -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
      </customHeaders>
    </httpProtocol>
    
    <!-- Enable compression for better performance -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    
    <!-- Health check endpoint for Azure -->
    <rewrite>
      <rules>
        <rule name="Health Check" stopProcessing="true">
          <match url="^health$" />
          <action type="Rewrite" url="/health.aspx" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
  
  <!-- Logging configuration for cloud monitoring -->
  <system.diagnostics>
    <trace autoflush="true">
      <listeners>
        <add name="ApplicationInsights" 
             type="Microsoft.ApplicationInsights.TraceListener.ApplicationInsightsTraceListener, Microsoft.ApplicationInsights.TraceListener" />
      </listeners>
    </trace>
  </system.diagnostics>
</configuration>
