<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=169433
  
  CLOUD READINESS NOTES:
  - Connection strings should be overridden via environment variables or Azure App Configuration
  - Session state is configured for Azure Cache for Redis (requires setup)
  - Application Insights is enabled for cloud monitoring
-->
<configuration>
  <connectionStrings>
    <!-- 
      CLOUD DEPLOYMENT: Override this connection string using:
      1. Azure App Service Application Settings
      2. Environment variable: SQLAZURECONNSTR_sqlCon1
      3. Azure Key Vault reference: @Microsoft.KeyVault(SecretUri=...)
      
      Example Azure SQL connection string:
      Server=tcp:yourserver.database.windows.net,1433;Initial Catalog=DBProject;Persist Security Info=False;User ID=yourusername;Password=yourpassword;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
    -->
    <add name="sqlCon1" 
         connectionString="Data Source=.\SQLEXPRESS; Initial Catalog=DBProject; Integrated Security=True" 
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Cloud-ready configuration settings -->
    <add key="Environment" value="Development" />
    <!-- Override in Azure App Service with Production, Staging, etc. -->
    
    <!-- Application Insights Instrumentation Key - Override in Azure -->
    <add key="ApplicationInsights:InstrumentationKey" value="" />
    
    <!-- Session Configuration -->
    <add key="SessionTimeout" value="20" />
    
    <!-- Azure Cache for Redis Configuration (for distributed session state) -->
    <!-- Uncomment and configure when deploying to Azure -->
    <!--
    <add key="RedisConnection" value="yourcache.redis.cache.windows.net:6380,password=yourpassword,ssl=True,abortConnect=False" />
    -->
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8"/>
    <httpRuntime targetFramework="4.8" maxRequestLength="10240" executionTimeout="3600"/>
    
    <!-- 
      SESSION STATE CONFIGURATION FOR CLOUD DEPLOYMENT
      
      For Azure deployment, configure distributed session state using one of these options:
      
      1. Azure Cache for Redis (RECOMMENDED for cloud):
      <sessionState mode="Custom" customProvider="MySessionStateStore">
        <providers>
          <add name="MySessionStateStore" 
               type="Microsoft.Web.Redis.RedisSessionStateProvider" 
               host="yourcache.redis.cache.windows.net" 
               accessKey="yourAccessKey" 
               ssl="true" />
        </providers>
      </sessionState>
      
      2. SQL Server Session State (Alternative):
      <sessionState mode="SQLServer" 
                    sqlConnectionString="Data Source=yourserver;Initial Catalog=ASPState;Integrated Security=True" 
                    cookieless="false" 
                    timeout="20" />
      
      Current configuration uses InProc (not suitable for cloud scale-out)
    -->
    <sessionState mode="InProc" 
                  timeout="20" 
                  cookieless="false" 
                  regenerateExpiredSessionId="true" />
    
    <httpModules>
      <add name="ApplicationInsightsWebTracking" type="Microsoft.ApplicationInsights.Web.ApplicationInsightsHttpModule, Microsoft.AI.Web"/>
    </httpModules>
    
    <!-- Custom errors for production -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx">
      <error statusCode="404" redirect="~/NotFound.aspx" />
      <error statusCode="500" redirect="~/Error.aspx" />
    </customErrors>
    
    <!-- Authentication configuration -->
    <authentication mode="Forms">
      <forms loginUrl="~/SignUp.aspx" 
             timeout="30" 
             slidingExpiration="true" 
             protection="All" 
             requireSSL="false" 
             cookieless="UseCookies" />
    </authentication>
    
    <!-- Disable trace in production -->
    <trace enabled="false" localOnly="true" pageOutput="false" />
  </system.web>
  
  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs"
        type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=1.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"
        warningLevel="4" compilerOptions="/langversion:6 /nowarn:1659;1699;1701"/>
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb"
        type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=1.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"
        warningLevel="4" compilerOptions="/langversion:14 /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+"/>
    </compilers>
  </system.codedom>
  
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false"/>
    <modules>
      <remove name="ApplicationInsightsWebTracking"/>
      <add name="ApplicationInsightsWebTracking" 
           type="Microsoft.ApplicationInsights.Web.ApplicationInsightsHttpModule, Microsoft.AI.Web"
           preCondition="managedHandler"/>
    </modules>
    
    <!-- Security headers for cloud deployment -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
      </customHeaders>
    </httpProtocol>
    
    <!-- URL Rewrite for HTTPS enforcement (uncomment for production) -->
    <!--
    <rewrite>
      <rules>
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
    -->
    
    <!-- Compression for better performance -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    
    <!-- Static content caching -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>
  </system.webServer>
  
  <!-- Health check endpoint configuration -->
  <location path="health">
    <system.web>
      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>
</configuration>
