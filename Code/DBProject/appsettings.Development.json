{
  // cr-dotnet-0010: Development environment overrides.
  // Replaces Web.Debug.config XDT transformations.
  // This file is used when ASPNETCORE_ENVIRONMENT=Development (local development / Debug builds).
  //
  // DO NOT store real secrets here. Use user-secrets or environment variables locally:
  //   dotnet user-secrets set "ConnectionStrings:sqlCon1" "your-local-connection-string"
  "ConnectionStrings": {
    // Override with your local SQL Server instance for development.
    // Alternatively, set the SQLCON1_CONNECTION_STRING environment variable.
    "sqlCon1": "Data Source=.\\SQLEXPRESS;Initial Catalog=DBProject;Integrated Security=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System": "Information"
    }
  },
  "DetailedErrors": true
}
