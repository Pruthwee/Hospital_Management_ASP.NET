<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud-ready: Web.Debug.config transformation.
  
  IMPORTANT: In AWS cloud deployments, Web.config transformations are NOT used.
  Configuration is externalized to environment variables and AWS Systems Manager Parameter Store.
  
  The application reads DB_CONNECTION_STRING environment variable at runtime (see DAL/myDAL.cs).
  Set environment variables in:
    - AWS ECS: Task Definition environment variables
    - AWS Elastic Beanstalk: Environment Properties
    - AWS EC2: Systems Manager Parameter Store with IAM role access
  
  This file is kept for local development compatibility only (cr-dotnet-0010).
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <system.web>
    <!--
      Debug build: keep debug compilation enabled for local development.
      In AWS cloud deployments, this transformation is not applied.
      Configuration is injected via environment variables at runtime.
    -->
  </system.web>
</configuration>
