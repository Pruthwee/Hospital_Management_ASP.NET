<?xml version="1.0" encoding="utf-8"?>
<!--
  Project migrated from ASP.NET Web Forms (.NET Framework 4.8) to ASP.NET Core Razor Pages (.NET 8).
  Rule: cr-dotnet-0026 — Web Forms Usage
  Remediation: Rewrite to ASP.NET Core Razor Pages and deploy to Azure Container Apps.
  
  Changes:
  - TargetFramework changed from net48 to net8.0
  - ProjectTypeGuids (Web Forms) removed
  - Web Forms references (System.Web, System.Web.UI, System.Web.UI.WebControls) removed
  - ASP.NET Core Razor Pages SDK added
  - Entity Framework 6 replaced with Microsoft.EntityFrameworkCore for .NET 8 compatibility
  - New Razor Page files (.cshtml / .cshtml.cs) added for all migrated pages
-->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>DBProject</RootNamespace>
    <AssemblyName>DBProject</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>DBProject-HospitalManagement</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core Razor Pages — replaces Web Forms pages -->
    <!-- Admin Razor Pages -->
    <Compile Include="Admin\AddStaff.cshtml.cs" />
    <Compile Include="Admin\AdminHome.cshtml.cs" />
    <Compile Include="Admin\DoctorRegistrationForm.cshtml.cs" />
    <Compile Include="Admin\ManageClinic.cshtml.cs" />

    <!-- Doctor Razor Pages -->
    <Compile Include="Doctor\Bill.cshtml.cs" />

    <!-- DAL -->
    <Compile Include="DAL\myDAL.cs" />
    <Compile Include="DAL\HospitalDbContext.cs" />
    <Compile Include="DAL\RedisSessionHelper.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core packages -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.RazorPages" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Session" Version="8.0.0" />

    <!-- Azure Cache for Redis — distributed session state (replaces InProc session) -->
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="8.0.0" />

    <!-- Entity Framework Core with SQL Server for Azure SQL -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- Azure Application Insights for cloud monitoring -->
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.22.0" />

    <!-- System.Data.SqlClient for existing DAL stored procedure calls -->
    <PackageReference Include="System.Data.SqlClient" Version="4.8.6" />
  </ItemGroup>

</Project>
