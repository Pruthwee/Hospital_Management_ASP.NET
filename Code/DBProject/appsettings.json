{
  // cr-dotnet-0010: Web.config Transformations — Migrated to environment-based configuration.
  // Base application settings. Environment-specific overrides are in:
  //   appsettings.Development.json  (Debug / local development)
  //   appsettings.Production.json   (Release / cloud deployment)
  //
  // Sensitive values (connection strings, API keys) MUST be provided via environment
  // variables or Azure Key Vault references — never hardcoded in these files.
  //
  // Connection string resolution order (DAL/myDAL.cs):
  //   1. SQLCON1_CONNECTION_STRING environment variable  (Azure App Service / Container Apps)
  //   2. ConnectionStrings:sqlCon1 in Web.config         (local development fallback)
  "ConnectionStrings": {
    // Set SQLCON1_CONNECTION_STRING environment variable in Azure to override this value.
    // Azure App Service: Configuration > Application Settings
    // Azure Container Apps: Environment Variables (use secret reference for production)
    // Azure Key Vault reference: @Microsoft.KeyVault(SecretUri=https://<vault>.vault.azure.net/secrets/sqlcon1-connection-string/)
    "sqlCon1": "Data Source=.\\SQLEXPRESS;Initial Catalog=DBProject;Integrated Security=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*"
}
