{
  "ConnectionStrings": {
    "sqlCon1": "#{SQL_CONNECTION_STRING}#"
  },
  "ApplicationInsights": {
    "InstrumentationKey": "#{APPINSIGHTS_INSTRUMENTATIONKEY}#"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Azure": {
    "Environment": "#{ASPNETCORE_ENVIRONMENT}#",
    "Region": "#{AZURE_REGION}#"
  },
  "SessionState": {
    "Mode": "InProc",
    "Timeout": 20,
    "RedisConnectionString": "#{REDIS_CONNECTION_STRING}#"
  },
  "Database": {
    "CommandTimeout": 30,
    "EnableRetryOnFailure": true,
    "MaxRetryCount": 3,
    "MaxRetryDelay": 10
  }
}
