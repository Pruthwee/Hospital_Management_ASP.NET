{
  // cr-dotnet-0010: Production environment overrides.
  // Replaces Web.Release.config XDT transformations.
  // This file is used when ASPNETCORE_ENVIRONMENT=Production (cloud deployment / Release builds).
  //
  // IMPORTANT: Do NOT store production secrets in this file.
  // Set the SQLCON1_CONNECTION_STRING environment variable in Azure:
  //
  //   Azure App Service:
  //     az webapp config appsettings set \
  //       --name <app-name> --resource-group <rg> \
  //       --settings SQLCON1_CONNECTION_STRING="<production-connection-string>"
  //
  //   Azure Key Vault reference (recommended):
  //     SQLCON1_CONNECTION_STRING=@Microsoft.KeyVault(SecretUri=https://<vault>.vault.azure.net/secrets/sqlcon1-connection-string/)
  //
  //   Azure Container Apps:
  //     az containerapp update --name <app-name> --resource-group <rg> \
  //       --set-env-vars SQLCON1_CONNECTION_STRING=secretref:sqlcon1-connection-string
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "DetailedErrors": false
}
