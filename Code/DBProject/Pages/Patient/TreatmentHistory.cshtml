@page
@model DBProject.TreatmentHistoryModel
@{
    Layout = "~/Pages/Patient/PatientLayout.cshtml";
    ViewData["Title"] = "";
}

<form method="post">
    <label id="THistory">@Model.THistoryText</label>
    <table id="THistoryGrid" class="table table-bordered">
        <thead>
            <tr>
                @foreach (var col in Model.THistoryGridColumns)
                {
                    <th>@col</th>
                }
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.THistoryGridRows.Count; i++)
            {
                var row = Model.THistoryGridRows[i];
                <tr>
                    @foreach (var cell in row)
                    {
                        <td>@cell</td>
                    }
                </tr>
            }
        </tbody>
    </table>
</form>
