@page
@model DBProject.Doctor.PreviousHistoryModel
@{
    Layout = "~/Pages/Doctor/DoctorLayout.cshtml";
    ViewData["Title"] = "";
}

<form method="post">
    <label id="PHistory">@Model.PHistoryText</label>
    <table id="PHistoryGrid" class="table table-bordered">
        <thead>
            <tr>
                @foreach (var col in Model.PHistoryGridColumns)
                {
                    <th>@col</th>
                }
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.PHistoryGridRows.Count; i++)
            {
                var row = Model.PHistoryGridRows[i];
                <tr>
                    @foreach (var cell in row)
                    {
                        <td>@cell</td>
                    }
                </tr>
            }
        </tbody>
    </table>
</form>
