@page
@model doctor.pendingappointmentModel
@{
    Layout = "~/Pages/Doctor/DoctorLayout.cshtml";
    ViewData["Title"] = "";
}

<form method="post">
    <table id="pendingappointments" class="table table-bordered">
        <thead>
            <tr>
                @foreach (var col in Model.PendingColumns)
                {
                    <th>@col</th>
                }
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.PendingRows.Count; i++)
            {
                var row = Model.PendingRows[i];
                <tr>
                    @foreach (var cell in row)
                    {
                        <td>@cell</td>
                    }
                    <td><a href="/Doctor/PendingAppointment?approve=1&rowIndex=@i" class="btn btn-success">Approve</a></td>
                    <td><a href="/Doctor/PendingAppointment?delete=1&rowIndex=@i" class="btn btn-danger">Delete</a></td>
                </tr>
            }
        </tbody>
    </table>
</form>
