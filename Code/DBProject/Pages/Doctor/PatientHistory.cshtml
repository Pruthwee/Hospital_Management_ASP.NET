@page
@model doctor.patienthistoryModel
@{
    Layout = "~/Pages/Doctor/DoctorLayout.cshtml";
    ViewData["Title"] = "";
}

<form method="post">
    <table id="patientsgrid" class="table table-bordered">
        <thead>
            <tr>
                @foreach (var col in Model.PatientsGridColumns)
                {
                    <th>@col</th>
                }
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.PatientsGridRows.Count; i++)
            {
                var row = Model.PatientsGridRows[i];
                <tr>
                    @foreach (var cell in row)
                    {
                        <td>@cell</td>
                    }
                    <td><a href="/Doctor/HistoryUpdate?rowIndex=@i" class="btn btn-default">Select</a></td>
                </tr>
            }
        </tbody>
    </table>
</form>
