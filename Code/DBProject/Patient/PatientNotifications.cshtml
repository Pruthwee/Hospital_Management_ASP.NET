@page
@model DBProject.Patient.PatientNotificationsModel
@{
    ViewData["Title"] = "Notifications";
    Layout = "~/Patient/_PatientLayout.cshtml";
}

<h1><strong style="margin:37%">Notifications</strong></h1>
<br /><br />

<div style="margin-left: 70px">

    @if (!string.IsNullOrEmpty(Model.NotifyMessage))
    {
        <p style="font-weight:bold; font-size:medium;">@Model.NotifyMessage</p>
    }
    <br /><br />

    @if (!string.IsNullOrEmpty(Model.DoctorMessage))
    {
        <p style="font-weight:bold; font-size:medium;">@Model.DoctorMessage</p>
    }
    <br /><br />

    @if (!string.IsNullOrEmpty(Model.TimingsMessage))
    {
        <p style="font-weight:bold; font-size:medium;">@Model.TimingsMessage</p>
    }
    <br /><br />

</div>
