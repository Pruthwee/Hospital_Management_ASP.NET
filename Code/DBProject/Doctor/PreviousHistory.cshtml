@page "/Doctor/PreviousHistory.aspx"
@model DBProject.Doctor.PreviousHistoryModel

@section head {
        <title> Previous History</title>
}

@section Cp1 {

    
    <!------------------Styling------------------>
    <link rel="stylesheet" href="/assets/css/grid-view.css"/>


    <h1><strong style="margin:25%">History of Treated Patients</strong></h1>
    <br /><br />

    <span id="PHistory">@Model.PHistory</span>
    <br /><br />

@if (Model.PHistoryGrid != null && Model.PHistoryGrid.Rows.Count > 0)
{
    <table class="GridView-d" cellspacing="0" cellpadding="4" rules="cols" border="1" id="PHistoryGrid" style="color:Black;background-color:White;border-color:#DEDFDE;border-width:1px;border-style:None;width:800px;border-collapse:collapse;">
        <tr style="color:White;background-color:#6B696B;font-weight:bold;">
            <th scope="col">No.</th>
            @foreach (DataColumn col in Model.PHistoryGrid.Columns)
            {
                <th scope="col">@col.ColumnName</th>
            }
        </tr>
        @for (int i = 0; i < Model.PHistoryGrid.Rows.Count; i++)
        {
            <tr style="background-color:@(i % 2 == 0 ? "#F7F7DE" : "White");">
                <td style="width:50px;"><span id="@("lblRowNumber_" + i)">@(i + 1)</span></td>
                @foreach (DataColumn col in Model.PHistoryGrid.Columns)
                {
                    <td>@Model.PHistoryGrid.Rows[i][col]</td>
                }
            </tr>
        }
    </table>
}

    <br /><br />

}
