@page "/Doctor/PatientHistory.aspx"
@model doctor.patienthistoryModel

@section head {
    <title>Patient History</title>
}

@section Cp1 {

    
    <!------------------Styling------------------>
    <link rel="stylesheet" href="/assets/css/grid-view.css"/>


     <h1><strong style="margin:25%">Today's Appointments</strong></h1>
    <br /><br />
    <div style="margin-left:150px">

@if (Model.Patientsgrid != null && Model.Patientsgrid.Rows.Count > 0)
{
    <table class="GridView-d" cellspacing="0" cellpadding="4" rules="cols" border="1" id="patientsgrid" style="color:Black;background-color:White;border-color:#DEDFDE;border-width:1px;border-style:None;width:1000px;border-collapse:collapse;">
        <tr style="color:White;background-color:#6B696B;font-weight:bold;">
            <th scope="col">&nbsp;</th>
            @foreach (DataColumn col in Model.Patientsgrid.Columns)
            {
                <th scope="col">@col.ColumnName</th>
            }
        </tr>
        @for (int i = 0; i < Model.Patientsgrid.Rows.Count; i++)
        {
            <tr style="background-color:@(i % 2 == 0 ? "#F7F7DE" : "White");">
                <td><button type="submit" name="rowIndex" value="@i" formaction="?handler=Select" style="background:none;border:none;padding:0;color:#0000EE;text-decoration:underline;cursor:pointer;">Select</button></td>
                @foreach (DataColumn col in Model.Patientsgrid.Columns)
                {
                    <td>@Model.Patientsgrid.Rows[i][col]</td>
                }
            </tr>
        }
    </table>
}

        </div>

    
    <br />
    <br />
    <br />
    <br />
    <br />
}
