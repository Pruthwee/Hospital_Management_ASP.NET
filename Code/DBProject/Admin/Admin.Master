    <footer class="footer-distributed">
        <div class="footer-left">
            <h3>MedicX<span>4</span></h3>
            <p class="footer-company-name">MedicX4 Health Care &copy; 2017</p>
        </div>
        <div class="footer-center">
            <div><i class="fa fa-map-marker"></i><p><span>Milaad St Block B</span> Faisal Town, Lahore</p></div>
            <div><i class="fa fa-phone"></i><p>0322 - 7561001</p></div>
            <div><i class="fa fa-envelope"></i><p><a href="mailto:support@medicx4.com">support@medicx4.com</a></p></div>
