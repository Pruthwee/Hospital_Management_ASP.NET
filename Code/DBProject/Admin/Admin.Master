<%-- 
    NOTE: This Web Forms Master Page has been superseded by Admin/_AdminLayout.cshtml (ASP.NET Core Razor Pages Layout).
    Migration: <%@ Master %> directive -> Razor Layout (_AdminLayout.cshtml)
    Migration: <asp:ContentPlaceHolder> -> @RenderBody() and @RenderSection() in Razor layout
    Migration: System.Web.UI.MasterPage -> No base class needed (Razor layout is a .cshtml file)
    This file is retained for reference only.
--%>
<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="DBProject.Admin" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <!-- Google Fonts -->
