@page "{doctorId:int}"
@model ClinicManagement.Web.Pages.Patient.DoctorProfileModel
@{
    ViewData["Title"] = "Doctor Profile";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        @if (Model.Doctor != null)
        {
            <div class="card shadow">
                <div class="card-header bg-primary text-white text-center">
                    <h4><i class="fas fa-user-md me-2"></i>Doctor Profile</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 text-center">
                            <i class="fas fa-user-md fa-6x text-primary mb-3"></i>
                            <h4>@Model.Doctor.Name</h4>
                            <p class="badge bg-primary">@Model.Doctor.DepartmentName</p>
                        </div>
                        <div class="col-md-8">
                            <table class="table">
                                <tr><th>Specialization</th><td>@Model.Doctor.Specialization</td></tr>
                                <tr><th>Qualification</th><td>@Model.Doctor.Qualification</td></tr>
                                <tr><th>Experience</th><td>@Model.Doctor.WorkExperience years</td></tr>
                                <tr><th>Charges/Visit</th><td>$@Model.Doctor.ChargesPerVisit</td></tr>
                                <tr><th>Patients Treated</th><td>@Model.Doctor.PatientsTreated</td></tr>
                                <tr><th>Repute Index</th><td>@Model.Doctor.ReputeIndex.ToString("F2")</td></tr>
                                <tr><th>Phone</th><td>@Model.Doctor.Phone</td></tr>
                            </table>
                        </div>
                    </div>
                    <div class="text-center mt-3">
                        <a asp-page="/Patient/TakeAppointment"
                           asp-route-doctorId="@Model.Doctor.DoctorId"
                           class="btn btn-success">
                            <i class="fas fa-calendar-plus me-2"></i>Book Appointment
                        </a>
                        <a asp-page="/Patient/ViewDoctors" class="btn btn-secondary ms-2">
                            <i class="fas fa-arrow-left me-2"></i>Back
                        </a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning">Doctor not found.</div>
        }
    </div>
</div>
