@page
@model ClinicManagement.Web.Pages.Patient.TreatmentHistoryModel
@{
    ViewData["Title"] = "Treatment History";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-notes-medical me-2"></i>Treatment History</h2>
        <hr />
    </div>
</div>

<div class="card shadow">
    <div class="card-body">
        @if (!Model.Treatments.Any())
        {
            <div class="alert alert-info">No treatment history found.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Doctor</th>
                            <th>Date</th>
                            <th>Disease</th>
                            <th>Progress</th>
                            <th>Prescription</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Treatments)
                        {
                            <tr>
                                <td>@t.AppointId</td>
                                <td>@t.DoctorName</td>
                                <td>@t.Timings</td>
                                <td>@t.Disease</td>
                                <td>@t.Progress</td>
                                <td>@t.Prescription</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<a asp-page="/Patient/PatientHome" class="btn btn-secondary mt-3">
    <i class="fas fa-arrow-left me-2"></i>Back
</a>
