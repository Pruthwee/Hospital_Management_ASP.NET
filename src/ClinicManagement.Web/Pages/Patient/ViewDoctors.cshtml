@page
@model ClinicManagement.Web.Pages.Patient.ViewDoctorsModel
@{
    ViewData["Title"] = "View Doctors";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-user-md me-2"></i>View Doctors</h2>
        <hr />
    </div>
</div>

<div class="card shadow mb-4">
    <div class="card-body">
        <form method="get">
            <div class="row g-3">
                <div class="col-md-6">
                    <select name="department" class="form-select" asp-items="@(new SelectList(Model.Departments, "DeptName", "DeptName", Model.SelectedDepartment))">
                        <option value="">All Departments</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search me-1"></i>Search
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="row">
    @foreach (var doctor in Model.Doctors)
    {
        <div class="col-md-4 mb-4">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <i class="fas fa-user-md fa-4x text-primary mb-3"></i>
                    <h5>@doctor.Name</h5>
                    <p class="text-muted">@doctor.DepartmentName</p>
                    <p><strong>Specialization:</strong> @doctor.Specialization</p>
                    <p><strong>Charges:</strong> $@doctor.ChargesPerVisit</p>
                    <p><strong>Experience:</strong> @doctor.WorkExperience years</p>
                    <a asp-page="/Patient/DoctorProfile"
                       asp-route-doctorId="@doctor.DoctorId"
                       class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-eye me-1"></i>View Profile
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<a asp-page="/Patient/PatientHome" class="btn btn-secondary mt-3">
    <i class="fas fa-arrow-left me-2"></i>Back
</a>
