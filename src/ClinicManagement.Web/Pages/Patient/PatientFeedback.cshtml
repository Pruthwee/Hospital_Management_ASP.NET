@page
@model ClinicManagement.Web.Pages.Patient.PatientFeedbackModel
@{
    ViewData["Title"] = "Patient Feedback";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow">
            <div class="card-header bg-secondary text-white">
                <h4><i class="fas fa-star me-2"></i>Patient Feedback</h4>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.Message))
                {
                    <div class="alert alert-success">@Model.Message</div>
                }
                @if (Model.PendingFeedback != null)
                {
                    <div class="alert alert-info">
                        <h5>Pending Feedback</h5>
                        <p><strong>Doctor:</strong> @Model.PendingFeedback.DoctorName</p>
                        <p><strong>Appointment Time:</strong> @Model.PendingFeedback.Timings</p>
                    </div>
                    <form method="post">
                        <input type="hidden" name="appointmentId" value="@Model.PendingFeedback.AppointmentId" />
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-thumbs-up me-2"></i>Submit Feedback
                        </button>
                    </form>
                }
                else
                {
                    <div class="alert alert-info">No pending feedback.</div>
                }
            </div>
        </div>
    </div>
</div>

<a asp-page="/Patient/PatientHome" class="btn btn-secondary mt-3">
    <i class="fas fa-arrow-left me-2"></i>Back
</a>
