@page
@model ClinicManagement.Web.Pages.Doctor.PatientHistoryModel
@{
    ViewData["Title"] = "Today's Patients";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-calendar-day me-2"></i>Today's Patients</h2>
        <hr />
    </div>
</div>

<div class="card shadow">
    <div class="card-body">
        @if (!Model.Appointments.Any())
        {
            <div class="alert alert-info">No appointments for today.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Appointment ID</th>
                            <th>Patient Name</th>
                            <th>Time</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model.Appointments)
                        {
                            <tr>
                                <td>@appt.AppointId</td>
                                <td>@appt.PatientName</td>
                                <td>@appt.Timings</td>
                                <td><span class="badge bg-success">@appt.AppointmentStatus</span></td>
                                <td>
                                    <a asp-page="/Doctor/HistoryUpdate"
                                       asp-route-appointmentId="@appt.AppointId"
                                       class="btn btn-primary btn-sm">
                                        <i class="fas fa-edit me-1"></i>Update
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<a asp-page="/Doctor/DoctorHome" class="btn btn-secondary mt-3">
    <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
</a>
