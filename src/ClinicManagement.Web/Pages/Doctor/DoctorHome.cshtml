@page
@model ClinicManagement.Web.Pages.Doctor.DoctorHomeModel
@{
    ViewData["Title"] = "Doctor Dashboard";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-user-md me-2"></i>Doctor Dashboard</h2>
        <hr />
    </div>
</div>

@if (Model.DoctorInfo != null)
{
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card shadow text-center">
                <div class="card-body">
                    <i class="fas fa-user-md fa-5x text-primary mb-3"></i>
                    <h4>@Model.DoctorInfo.Name</h4>
                    <p class="text-muted">@Model.DoctorInfo.DepartmentName</p>
                    <p><strong>Specialization:</strong> @Model.DoctorInfo.Specialization</p>
                    <p><strong>Charges/Visit:</strong> $@Model.DoctorInfo.ChargesPerVisit</p>
                    <p><strong>Patients Treated:</strong> @Model.DoctorInfo.PatientsTreated</p>
                    <p><strong>Repute Index:</strong> @Model.DoctorInfo.ReputeIndex.ToString("F2")</p>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5><i class="fas fa-tools me-2"></i>Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <a asp-page="/Doctor/PendingAppointment" class="btn btn-outline-warning w-100 py-3">
                                <i class="fas fa-clock fa-2x d-block mb-2"></i>Pending Appointments
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a asp-page="/Doctor/PatientHistory" class="btn btn-outline-primary w-100 py-3">
                                <i class="fas fa-history fa-2x d-block mb-2"></i>Today's Patients
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a asp-page="/Doctor/PreviousHistory" class="btn btn-outline-info w-100 py-3">
                                <i class="fas fa-file-medical fa-2x d-block mb-2"></i>Previous History
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a asp-page="/Doctor/Bill" class="btn btn-outline-success w-100 py-3">
                                <i class="fas fa-file-invoice-dollar fa-2x d-block mb-2"></i>Generate Bill
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
