@page
@model ClinicManagement.Web.Pages.Doctor.PreviousHistoryModel
@{
    ViewData["Title"] = "Previous History";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-file-medical me-2"></i>Previous Patient History</h2>
        <hr />
    </div>
</div>

<div class="card shadow">
    <div class="card-body">
        @if (!Model.Appointments.Any())
        {
            <div class="alert alert-info">No previous history found.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Patient</th>
                            <th>Date</th>
                            <th>Disease</th>
                            <th>Progress</th>
                            <th>Prescription</th>
                            <th>Bill</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model.Appointments)
                        {
                            <tr>
                                <td>@appt.AppointId</td>
                                <td>@appt.PatientName</td>
                                <td>@appt.Timings</td>
                                <td>@appt.Disease</td>
                                <td>@appt.Progress</td>
                                <td>@appt.Prescription</td>
                                <td>
                                    <span class="badge @(appt.BillStatus == "Paid" ? "bg-success" : "bg-warning")">
                                        @appt.BillStatus
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<a asp-page="/Doctor/DoctorHome" class="btn btn-secondary mt-3">
    <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
</a>
