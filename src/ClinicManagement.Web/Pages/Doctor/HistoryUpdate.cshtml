@page "{appointmentId:int}"
@model ClinicManagement.Web.Pages.Doctor.HistoryUpdateModel
@{
    ViewData["Title"] = "Update History";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4><i class="fas fa-edit me-2"></i>Update Patient History</h4>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.Message))
                {
                    <div class="alert alert-success">@Model.Message</div>
                }
                <form method="post">
                    <input type="hidden" asp-for="AppointmentId" />
                    <div class="mb-3">
                        <label asp-for="Disease" class="form-label">Disease</label>
                        <input asp-for="Disease" class="form-control" placeholder="Enter disease" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Progress" class="form-label">Progress</label>
                        <textarea asp-for="Progress" class="form-control" rows="3" placeholder="Enter progress notes"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Prescription" class="form-label">Prescription</label>
                        <textarea asp-for="Prescription" class="form-control" rows="3" placeholder="Enter prescription"></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>Save
                        </button>
                        <a asp-page="/Doctor/PatientHistory" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Back
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
