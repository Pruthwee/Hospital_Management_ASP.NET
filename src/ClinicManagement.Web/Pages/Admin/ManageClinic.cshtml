@page
@model ClinicManagement.Web.Pages.Admin.ManageClinicModel
@{
    ViewData["Title"] = "Manage Clinic";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-clinic-medical me-2"></i>Manage Clinic</h2>
        <hr />
    </div>
</div>

<!-- Doctors Section -->
<div class="card shadow mb-4">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-user-md me-2"></i>Doctors</h5>
        <a asp-page="/Admin/DoctorRegistrationForm" class="btn btn-light btn-sm">
            <i class="fas fa-plus me-1"></i>Add Doctor
        </a>
    </div>
    <div class="card-body">
        <form method="get" class="mb-3">
            <div class="input-group">
                <input type="text" name="doctorSearch" value="@Model.DoctorSearch" class="form-control" placeholder="Search doctors..." />
                <button type="submit" class="btn btn-outline-primary">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </form>
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Department</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doctor in Model.Doctors)
                    {
                        <tr>
                            <td>@doctor.DoctorId</td>
                            <td>@doctor.Name</td>
                            <td>@doctor.DepartmentName</td>
                            <td>
                                <form method="post" asp-page-handler="DeleteDoctor" style="display:inline">
                                    <input type="hidden" name="doctorId" value="@doctor.DoctorId" />
                                    <button type="submit" class="btn btn-danger btn-sm"
                                        onclick="return confirm('Are you sure you want to remove this doctor?')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Patients Section -->
<div class="card shadow mb-4">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0"><i class="fas fa-users me-2"></i>Patients</h5>
    </div>
    <div class="card-body">
        <form method="get" class="mb-3">
            <div class="input-group">
                <input type="text" name="patientSearch" value="@Model.PatientSearch" class="form-control" placeholder="Search patients..." />
                <button type="submit" class="btn btn-outline-success">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </form>
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Phone</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var patient in Model.Patients)
                    {
                        <tr>
                            <td>@patient.PatientId</td>
                            <td>@patient.Name</td>
                            <td>@patient.Phone</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Staff Section -->
<div class="card shadow mb-4">
    <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-users-cog me-2"></i>Other Staff</h5>
        <a asp-page="/Admin/AddStaff" class="btn btn-dark btn-sm">
            <i class="fas fa-plus me-1"></i>Add Staff
        </a>
    </div>
    <div class="card-body">
        <form method="get" class="mb-3">
            <div class="input-group">
                <input type="text" name="staffSearch" value="@Model.StaffSearch" class="form-control" placeholder="Search staff..." />
                <button type="submit" class="btn btn-outline-warning">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </form>
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Designation</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var staff in Model.Staff)
                    {
                        <tr>
                            <td>@staff.StaffId</td>
                            <td>@staff.Name</td>
                            <td>@staff.Designation</td>
                            <td>
                                <form method="post" asp-page-handler="DeleteStaff" style="display:inline">
                                    <input type="hidden" name="staffId" value="@staff.StaffId" />
                                    <button type="submit" class="btn btn-danger btn-sm"
                                        onclick="return confirm('Are you sure you want to remove this staff member?')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
