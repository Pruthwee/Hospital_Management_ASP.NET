@page
@model ClinicManagement.Web.Pages.Admin.AdminHomeModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-tachometer-alt me-2"></i>Admin Dashboard</h2>
        <hr />
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h5 class="card-title">Total Patients</h5>
                        <h2>@Model.HomeData.TotalPatients</h2>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-users fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h5 class="card-title">Total Doctors</h5>
                        <h2>@Model.HomeData.TotalDoctors</h2>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-user-md fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-warning text-white shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h5 class="card-title">Total Income</h5>
                        <h2>$@Model.HomeData.TotalIncome.ToString("N2")</h2>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-dollar-sign fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-info text-white">
                <h5><i class="fas fa-building me-2"></i>Departments</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    @foreach (var dept in Model.HomeData.Departments)
                    {
                        <li class="list-group-item">
                            <i class="fas fa-hospital me-2 text-info"></i>@dept.DeptName
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-secondary text-white">
                <h5><i class="fas fa-tools me-2"></i>Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-page="/Admin/ManageClinic" class="btn btn-outline-primary">
                        <i class="fas fa-clinic-medical me-2"></i>Manage Clinic
                    </a>
                    <a asp-page="/Admin/DoctorRegistrationForm" class="btn btn-outline-success">
                        <i class="fas fa-user-md me-2"></i>Register Doctor
                    </a>
                    <a asp-page="/Admin/AddStaff" class="btn btn-outline-warning">
                        <i class="fas fa-user-plus me-2"></i>Add Staff
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
